  "fixed_sql": [
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"account_id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"display_name\" TEXT NOT NULL, \"birth_year\" INTEGER, \"weight_kg\" REAL, \"sex\" TEXT, \"activity_level\" TEXT, \"wake_time\" TEXT, \"sleep_time\" TEXT, \"timezone\" TEXT NOT NULL, \"units\" TEXT NOT NULL DEFAULT 'ml', \"locale\" TEXT NOT NULL DEFAULT 'en', \"experience\" TEXT NOT NULL DEFAULT 'normal', \"fluid_restriction_ml\" INTEGER, \"goal_override_ml\" INTEGER, \"adaptive_weather\" INTEGER NOT NULL DEFAULT TRUE, \"adaptive_activity\" INTEGER NOT NULL DEFAULT TRUE, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT);"
        }
      ]
    },
    {
      "name": "drink_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"drink_logs\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"profile_id\" TEXT NOT NULL, \"drink_id\" TEXT NOT NULL, \"volume_ml\" INTEGER NOT NULL, \"hydration_ml\" INTEGER NOT NULL, \"caffeine_mg\" REAL, \"sugar_g\" REAL, \"source\" TEXT NOT NULL, \"logged_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT);"
        }
      ]
    },
    {
      "name": "drink_logs_profile_logged_at",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX drink_logs_profile_logged_at ON drink_logs (profile_id, logged_at)"
        }
      ]
    },
    {
      "name": "custom_drinks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"custom_drinks\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"account_id\" TEXT, \"name\" TEXT, \"icon\" TEXT, \"water_pct\" REAL, \"sugar_g_100ml\" REAL, \"caffeine_mg_100ml\" REAL, \"updated_at\" TEXT, \"deleted_at\" TEXT);"
        }
      ]
    },
    {
      "name": "daily_goals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_goals\" (\"profile_id\" TEXT NOT NULL, \"day\" TEXT NOT NULL, \"base_ml\" INTEGER, \"weather_ml\" INTEGER, \"activity_ml\" INTEGER, \"final_ml\" INTEGER, \"reason\" TEXT, PRIMARY KEY(profile_id, day));"
        }
      ]
    },
    {
      "name": "reminder_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminder_settings\" (\"profile_id\" TEXT NOT NULL PRIMARY KEY, \"mode\" TEXT, \"interval_min\" INTEGER, \"fixed_times\" TEXT, \"weekdays\" TEXT, \"quiet_start\" TEXT, \"quiet_end\" TEXT, \"skip_if_logged_min\" INTEGER DEFAULT 30, \"vibration_pattern\" TEXT, \"text_style\" TEXT, \"updated_at\" TEXT);"
        }
      ]
    },
    {
      "name": "fasting_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"fasting_settings\" (\"profile_id\" TEXT NOT NULL PRIMARY KEY, \"enabled\" INTEGER, \"type\" TEXT, \"custom_days\" TEXT, \"if_window\" TEXT, \"calc_method\" TEXT, \"split_pattern\" TEXT DEFAULT '2-4-2', \"updated_at\" TEXT);"
        }
      ]
    },
