<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for Android 12 and higher (D-33). The
     encrypted local DB is excluded: its key is not backed up, so a restored
     copy could never be opened. drift_flutter stores it in
     getApplicationDocumentsDirectory(), i.e. <dataDir>/app_flutter/onemoresip.sqlite
     (core/db/database_providers.dart). Everything else keeps the default
     behaviour. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/onemoresip.sqlite" />
        <exclude domain="root" path="app_flutter/onemoresip.sqlite-journal" />
        <exclude domain="root" path="app_flutter/onemoresip.sqlite-wal" />
        <exclude domain="root" path="app_flutter/onemoresip.sqlite-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/onemoresip.sqlite" />
        <exclude domain="root" path="app_flutter/onemoresip.sqlite-journal" />
        <exclude domain="root" path="app_flutter/onemoresip.sqlite-wal" />
        <exclude domain="root" path="app_flutter/onemoresip.sqlite-shm" />
    </device-transfer>
</data-extraction-rules>
